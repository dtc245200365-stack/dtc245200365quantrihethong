# Sao chép file này thành .env rồi đổi TẤT CẢ giá trị CHANGE_ME (mật khẩu >= 16 ký tự, chỉ chữ + số).
# KHÔNG commit file .env.

# Giữ đúng tên dự án để dùng lại các volume dữ liệu đã có (thư mục gốc C:\DoAn_QuanTriHeThong)
COMPOSE_PROJECT_NAME=doan_quantrihethong

# --- Địa chỉ truy cập qua Nginx ---
HTTP_PORT=8080
HTTPS_PORT=443
# Nếu đổi HTTPS_PORT khác 443 thì ghi kèm cổng, ví dụ https://localhost:8443
PUBLIC_URL=https://localhost

# --- MySQL (WordPress) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=CHANGE_ME

# --- Giám sát (Prometheus + Grafana) ---
# Tài khoản MySQL riêng cho exporter (không dùng root)
EXPORTER_DB_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Nếu Grafana báo lỗi nâng cấp CSDL khi khởi động, đặt đúng phiên bản bạn đã chạy trước đây, ví dụ:
# GRAFANA_VERSION=12.3.0
# PROMETHEUS_VERSION=v3.5.0
