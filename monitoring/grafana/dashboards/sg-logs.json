{
 "uid": "sg-logs",
 "title": "Summit Gear – Log tập trung (Loki)",
 "tags": [
  "summit-gear",
  "logging"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "LogQL 1: Request Nginx mỗi giây",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "drawStyle": "line"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate({service=\"nginx\"}[1m]))",
     "legendFormat": "requests",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "LogQL 2: Request theo mã trạng thái HTTP",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 30,
      "drawStyle": "bars"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (count_over_time({service=\"nginx\"} | pattern `<ip> - <user> [<_>] \"<method> <uri> <_>\" <status> <size> \"<_>\" \"<_>\" \"<_>\" rt=<rt>` [1m]))",
     "legendFormat": "{{status}}",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "LogQL 3: Dòng lỗi/cảnh báo theo dịch vụ (5 phút)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 30,
      "drawStyle": "bars"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (count_over_time({container=~\"product_.*\"} |~ \"(?i)(error|fatal|critical)\" [5m]))",
     "legendFormat": "{{service}}",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "logs",
   "title": "Log truy cập Nginx",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"nginx\"}",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Log lỗi 4xx/5xx của Nginx",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"nginx\"} | pattern `<ip> - <user> [<_>] \"<method> <uri> <_>\" <status> <size> \"<_>\" \"<_>\" \"<_>\" rt=<rt>` | status >= 400",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "logs",
   "title": "Log MySQL (lỗi/cảnh báo)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=\"mysql\"} |~ \"(?i)(warn|error)\"",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "logs",
   "title": "Log mọi container (tìm kiếm)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": false,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{container=~\"product_.*\"}",
     "queryType": "range",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}